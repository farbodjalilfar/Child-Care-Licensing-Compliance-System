@page "/facilities"
@inject IFacilityQueryService FacilityQuery

<PageTitle>My centres - Child Care Licensing</PageTitle>

<PageHeading Title="My centres" Audience="PageHeading.AudienceKind.Operator">
    The centres registered to you, with the state of each licence and application.
</PageHeading>

@if (isLoading)
{
    <p role="status" aria-live="polite">Loading centres...</p>
}
else if (loadError is not null)
{
    <div class="alert alert-error" role="alert">@loadError</div>
}
else if (facilities.Count == 0)
{
    <div class="empty-state">
        <h2>No centres registered</h2>
        <p>Once a centre is registered it will appear here with its licence status.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table>
            <caption class="visually-hidden">Registered child care centres</caption>
            <thead>
                <tr>
                    <th scope="col">Centre</th>
                    <th scope="col">Location</th>
                    <th scope="col">Rooms</th>
                    <th scope="col">Licensed capacity</th>
                    <th scope="col">Licence</th>
                    <th scope="col">Application</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var facility in facilities)
                {
                    <tr>
                        <th scope="row">@facility.Name</th>
                        <td>@facility.City, @facility.Province</td>
                        <td>@facility.RoomCount</td>
                        <td>@(facility.LicensedCapacity > 0 ? $"{facility.LicensedCapacity} children" : "Not yet set")</td>
                        <td>
                            <StatusBadge Status="@facility.LicenceStatus" />
                            @if (facility.LicenceExpiresAtUtc is { } expiry)
                            {
                                <span class="cell-note">expires @expiry.ToString("yyyy-MM-dd")</span>
                            }
                        </td>
                        <td>
                            @if (facility.ApplicationStatus is { } status)
                            {
                                <StatusBadge Status="@status" />
                            }
                            else
                            {
                                <span class="cell-note">None</span>
                            }
                        </td>
                        <td>
                            <a class="button button-secondary button-small"
                               href="/facilities/@facility.Id/application">
                                Open application
                                <span class="visually-hidden"> for @facility.Name</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<FacilitySummary> facilities = [];
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            facilities = await FacilityQuery.ListAsync();
        }
        catch (Exception)
        {
            loadError = "Could not load centres. Make sure the database is running.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
