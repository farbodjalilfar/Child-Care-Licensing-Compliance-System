@page "/registry"
@inject IPublicRegistryService RegistryService

<PageTitle>Find a licensed centre - Child Care Licensing</PageTitle>

<PageHeading Title="Find a licensed child care centre" Audience="PageHeading.AudienceKind.Public">
    Search the public register to check whether a centre is licensed, when its licence
    expires, and what inspectors have found.
</PageHeading>

<form class="filter-form" role="search" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
    <div class="field">
        <label for="city">City</label>
        <input id="city" type="search" @bind="city" @bind:event="oninput" placeholder="Toronto" />
    </div>
    <div class="field">
        <label for="name">Centre name</label>
        <input id="name" type="search" @bind="name" @bind:event="oninput" placeholder="Maple" />
    </div>
    <div class="field field-actions">
        <button type="submit" class="button">Search</button>
        <button type="button" class="button button-secondary" @onclick="ResetAsync">Clear</button>
    </div>
</form>

@if (isLoading)
{
    <p role="status" aria-live="polite">Searching the register...</p>
}
else if (loadError is not null)
{
    <div class="alert alert-error" role="alert">@loadError</div>
}
else if (results.Count == 0)
{
    <div class="empty-state">
        <h2>No centres found</h2>
        <p>No centre on the register matches that city or name. Try a broader search.</p>
    </div>
}
else
{
    <p class="result-count" role="status" aria-live="polite">
        Showing @results.Count centre@(results.Count == 1 ? "" : "s")
    </p>

    <ul class="result-list">
        @foreach (var facility in results)
        {
            <li class="result-card">
                <div class="result-main">
                    <h2><a href="/registry/@facility.FacilityId">@facility.Name</a></h2>
                    <p class="result-meta">@facility.City, @facility.Province</p>
                    <p class="result-meta">
                        Licence @(facility.LicenceNumber ?? "not issued")
                        @if (facility.LicenceExpiresAtUtc is { } expiry)
                        {
                            <span> &middot; expires @expiry.ToString("MMMM d, yyyy")</span>
                        }
                    </p>
                </div>
                <div class="result-side">
                    <StatusBadge Status="@facility.LicenceStatus" />
                    <p class="result-findings @(facility.OpenViolations > 0 ? "text-error" : "")">
                        @(facility.OpenViolations == 0
                            ? "No outstanding findings"
                            : $"{facility.OpenViolations} outstanding finding{(facility.OpenViolations == 1 ? "" : "s")}")
                    </p>
                </div>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<PublicFacilityListing> results = [];
    private string? city;
    private string? name;
    private bool isLoading = true;
    private string? loadError;

    protected override Task OnInitializedAsync() => SearchAsync();

    private async Task SearchAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            results = await RegistryService.SearchAsync(city, name);
        }
        catch (Exception)
        {
            loadError = "Could not load the register. Make sure the database is running.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task ResetAsync()
    {
        city = null;
        name = null;
        return SearchAsync();
    }
}
