@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="layout">
    <div class="masthead">
        <div class="masthead-inner">
            <a class="brand" href="/">
                <span class="brand-mark" aria-hidden="true">CCL</span>
                <span class="brand-text">
                    <span class="brand-title">Child Care Licensing and Compliance</span>
                    <span class="brand-subtitle">Licensing, inspection and public register</span>
                </span>
            </a>
            <p class="demo-tag">Demo &mdash; sample data only</p>
        </div>
    </div>

    <header class="site-header">
        <NavMenu />
    </header>

    <main id="main-content" class="page" tabindex="-1">
        @Body
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <p>
                Personal learning project. Not affiliated with, endorsed by, or connected to
                the Government of Ontario.
            </p>
            <p class="footer-links">
                <a href="/health">Service health</a>
                <span aria-hidden="true">&middot;</span>
                <a href="/openapi/v1.json">API documentation</a>
            </p>
        </div>
    </footer>
</div>
